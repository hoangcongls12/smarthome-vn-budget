# Astro Smart Home VN Budget - Environment Variables
# Copy to .env and fill in your values

# Site Configuration
SITE_URL=https://smarthomevn.pages.dev
SITE_NAME="Smart Home VN Budget"

# Analytics
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
UMAMI_WEBSITE_ID=your-umami-website-id
UMAMI_SCRIPT_URL=https://analytics.yourdomain.com/script.js

# Affiliate Tracking
AFFILIATE_UTM_SOURCE=smarthomevn
AFFILIATE_UTM_MEDIUM=affiliate
AFFILIATE_UTM_CAMPAIGN=content

# Affiliate Program IDs (replace with your actual IDs)
SHOPEE_AFFILIATE_ID=your_shopee_affiliate_id
LAZADA_AFFILIATE_ID=your_lazada_affiliate_id
AMAZON_ASSOCIATES_TAG=your_amazon_tag
GEARVN_REF=your_gearvn_ref
ANPHUOC_REF=your_anphuoc_ref
ALIEXPRESS_AFF_FID=your_aliexpress_fid

# Cloudflare (for Pages deployment)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_PAGES_PROJECT_NAME=smarthome-vn-budget

# Social (for meta tags)
TWITTER_HANDLE=@smarthomevn
FACEBOOK_APP_ID=your_facebook_app_id

# Search (if using Algolia/Meilisearch)
# ALGOLIA_APP_ID=your_app_id
# ALGOLIA_API_KEY=your_api_key
# ALGOLIA_INDEX_NAME=blog

# Email (for newsletter/forms)
# BUTTONDOWN_EMAIL_API_KEY=your_buttondown_key
# MAILERLITE_API_KEY=your_mailerlite_key