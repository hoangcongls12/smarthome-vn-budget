---
import BaseLayout from '@layouts/BaseLayout.astro';
import { generateArticleJsonLd, generateBreadcrumbJsonLd, SITE } from '@utils/seo';
import { formatDate } from '@utils/helpers';
import AnchorLink from '@components/ui/AnchorLink.astro';
import Badge from '@components/ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  publishedTime: string;
  modifiedTime: string;
  author: string;
  category: string;
  tags: string[];
  readingTime: number;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  category,
  tags,
  readingTime,
  jsonLd,
} = Astro.props;

const articleJsonLd = generateArticleJsonLd({
  title,
  description,
  url: canonical ? `${SITE.url}${canonical}` : Astro.url.href,
  image: ogImage ? `${SITE.url}${ogImage}` : SITE.ogImage,
  publishedTime,
  modifiedTime,
  author,
  publisher: SITE.name,
});

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Trang chủ', url: SITE.url },
  { name: category, url: `${SITE.url}/${category.toLowerCase().replace(/\s+/g, '-')}` },
  { name: title, url: canonical ? `${SITE.url}${canonical}` : Astro.url.href },
]);

const allJsonLd = [articleJsonLd, breadcrumbJsonLd, jsonLd].filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  section={category}
  tags={tags}
  jsonLd={allJsonLd[0]}
>
  <article class="prose-custom max-w-3xl mx-auto px-4 py-12 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500" role="list">
        <li>
          <a href="/" class="hover:text-primary-600 transition-colors">Trang chủ</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/${category.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-primary-600 transition-colors">{category}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-900 font-medium truncate max-w-[200px]" aria-current="page">{title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-gray-100">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-primary">{category}</span>
        {tags.slice(0, 3).map((tag) => (
          <span class="badge-gray">{tag}</span>
        ))}
      </div>
      <h1 class="heading-1 mb-6">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
        <time dateTime={publishedTime} class="flex items-center gap-1">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {formatDate(publishedTime)}
        </time>
        {modifiedTime !== publishedTime && (
          <time dateTime={modifiedTime} class="flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            Cập nhật: {formatDate(modifiedTime)}
          </time>
        )}
        <span class="flex items-center gap-1">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime} phút đọc
        </span>
        <span class="flex items-center gap-1">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {author}
        </span>
      </div>
    </header>

    <!-- Affiliate Disclaimer -->
    <div class="mb-10 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-800" role="note">
      <strong class="block mb-1">⚠️ Affiliate Disclosure:</strong>
      Một số liên kết trong bài viết là liên kết affiliate. Nếu bạn mua qua các liên kết này, chúng tôi có thể nhận được hoa hồng nhỏ <strong>không tốn chi phí thêm</strong> cho bạn. Điều này giúp duy trì hoạt động của trang web. Cảm ơn bạn đã hỗ trợ!
    </div>

    <!-- Table of Contents -->
    <aside class="hidden lg:block lg:w-64 lg:absolute lg:left-[-200px] lg:top-0 lg:sticky lg:top-24">
      <nav class="bg-gray-50 rounded-xl p-4" aria-label="Table of contents">
        <h3 class="font-semibold text-gray-900 mb-3">Nội dung bài viết</h3>
        <ul id="toc" class="space-y-2 text-sm text-gray-600" role="list">
          <!-- TOC will be populated by JS -->
        </ul>
      </nav>
    </aside>

    <!-- Article Content -->
    <div class="relative lg:ml-0">
      <slot />
    </div>

    <!-- Tags Footer -->
    <footer class="mt-12 pt-8 border-t border-gray-100">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-gray-500">Tags:</span>
        {tags.map((tag) => (
          <AnchorLink
            href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
            class="badge-gray hover:bg-gray-200 transition-colors"
          >
            {tag}
          </AnchorLink>
        ))}
      </div>
    </footer>

    <!-- Author Box -->
    <div class="mt-10 p-6 bg-gray-50 rounded-xl">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-lg">
          {author.charAt(0)}
        </div>
        <div>
          <h4 class="font-semibold text-gray-900">{author}</h4>
          <p class="text-sm text-gray-600 mt-1">Chuyên gia Smart Home, reviewer thiết bị IoT, người đam mê tự động hóa nhà thông minh giá rẻ.</p>
        </div>
      </div>
    </div>

    <!-- Related Posts Placeholder -->
    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="heading-3 mb-6">Bài viết liên quan</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="related-posts">
        <!-- Populated by JS or static -->
      </div>
    </section>
  </article>

  <!-- TOC Generator Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toc = document.getElementById('toc');
      const headings = document.querySelectorAll('.prose-custom h2, .prose-custom h3');
      
      if (headings.length > 0 && toc) {
        headings.forEach((heading, index) => {
          const id = heading.id || `heading-${index}`;
          heading.id = id;
          
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = heading.textContent;
          a.className = heading.tagName === 'H2' 
            ? 'block text-gray-700 hover:text-primary-600 transition-colors font-medium' 
            : 'block text-gray-600 hover:text-primary-600 transition-colors ml-4 text-sm';
          li.appendChild(a);
          toc.appendChild(li);
        });
      }
    });
  </script>