// src/components/affiliate/AffiliateProductCard.astro
---
import { SAMPLE_AFFILIATE_LINKS } from '@data/affiliate';
import Image from '@components/ui/Image.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import { cn } from '@utils/helpers';

interface Props {
  linkId: string;
  class?: string;
  showDescription?: boolean;
}

const { linkId, class: className = '', showDescription = true } = Astro.props;

const link = SAMPLE_AFFILIATE_LINKS.find((l) => l.id === linkId);

if (!link) {
  throw new Error(`Affiliate link not found: ${linkId}`);
}

const cloakedLink = `/go/${link.id}`;
---

<article class={cn('card bg-white rounded-2xl border border-gray-100 overflow-hidden flex flex-col', className)}>
  <div class="relative aspect-[4/3] bg-gray-100 overflow-hidden">
    {link.image ? (
      <Image
        src={link.image}
        alt={link.productName}
        width={400}
        height={300}
        class="object-cover transition-transform duration-300 hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary-100 to-accent-100">
        <svg class="h-16 w-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    {link.badge && (
      <Badge variant={link.badge === 'Best Seller' ? 'primary' : link.badge === 'Budget Pick' ? 'success' : link.badge === 'Premium' ? 'accent' : 'warning'} class="absolute top-3 left-3">
        {link.badge}
      </Badge>
    )}
  </div>

  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">{link.productName}</h3>

    <div class="flex items-center gap-2 mb-3">
      {link.price && (
        <span class="text-xl font-bold text-primary-600">
          {new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', minimumFractionDigits: 0 }).format(link.price)}
        </span>
      )}
      {link.originalPrice && link.price && link.originalPrice > link.price && (
        <span class="text-sm text-gray-400 line-through">
          {new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', minimumFractionDigits: 0 }).format(link.originalPrice)}
        </span>
      )}
      {link.rating && (
        <span class="flex items-center gap-1 text-sm text-yellow-600 ml-auto">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          {link.rating}
          {link.reviewCount && ` (${link.reviewCount.toLocaleString('vi-VN')})`}
        </span>
      )}
    </div>

    {showDescription && link.description && (
      <p class="text-sm text-gray-600 mb-4 line-clamp-3 flex-1">{link.description}</p>
    )}

    <Button
      href={cloakedLink}
      variant="primary"
      class="w-full"
      target="_blank"
      rel="noopener noreferrer"
    >
      Xem chi tiết & Mua hàng
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
    </Button>
  </div>
</article>