// src/components/affiliate/AffiliateDisclosure.astro
---
import { SITE_CONFIG } from '@data/site';
---

<div class="affiliate-disclosure my-8 p-4 bg-yellow-50 border border-yellow-200 rounded-lg" role="note">
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-yellow-100 flex items-center justify-center">
      <svg class="w-5 h-5 text-yellow-700" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
    </div>
    <div>
      <p class="font-semibold text-yellow-800 mb-1">Affiliate Disclosure</p>
      <p class="text-sm text-yellow-700">
        {SITE_CONFIG.affiliate.disclaimer}
      </p>
    </div>
  </div>
</div>

<style>
  .affiliate-disclosure {
    @apply animate-fade-in;
  }
</style>