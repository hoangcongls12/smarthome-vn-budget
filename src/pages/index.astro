---
import { SITE_CONFIG } from '../data/site';
import Button from '../components/ui/Button.astro';
---

<!doctype html>
<html lang="vi-VN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_CONFIG.name}</title>
    <meta name="description" content={SITE_CONFIG.description} />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-gray-900">
    <main class="flex-1 flex items-center justify-center px-4 py-20">
      <div class="text-center max-w-3xl">
        <h1 class="text-5xl font-bold text-primary-600 mb-6">{SITE_CONFIG.name}</h1>
        <p class="text-xl text-gray-600 mb-10">{SITE_CONFIG.tagline}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/budget-build" variant="primary" size="lg">Budget Build</Button>
          <Button href="/huong-dan" variant="outline" size="lg">Huong dan</Button>
        </div>
      </div>
    </main>
    
    <footer class="py-12 border-t border-gray-100 text-center text-sm text-gray-500">
      <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}</p>
    </footer>
  </body>
</html>